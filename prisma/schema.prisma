// Prisma schema for the Hospital Labour Portal
// Generates the client into src/generated/prisma (see output below)

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Required for tsx/Turbopack compatibility: generated imports use ".ts"
  // instead of ".js" so the TypeScript runner can resolve them.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DOCTOR
}

enum OperationType {
  CESARIAN
  OPERATION_PROGRAMME
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  name         String
  passwordHash String
  role         Role          @default(DOCTOR)
  isActive     Boolean       @default(true)
  reports      LabourReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  nationality   String
  bloodType     BloodType
  birthPlace    String?
  medicalHistory String?
  reports       LabourReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LabourReport {
  id                       String        @id @default(cuid())
  patientId                String
  doctorId                 String
  firstName                String
  lastName                 String
  dateOfBirth              DateTime
  nationality              String
  bloodType                BloodType
  operationType            OperationType
  deliveryDate             DateTime      @default(now())
  operatorFullName         String
  anesthesiologistFullName String
  assistantFullName        String?
  complications            String?
  fullDescription          String        @db.Text
  postOpNotes              String?

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  User    @relation(fields: [doctorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}